{
  "name": "tanstack-start-example-basic",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-friendly.mjs",
    "verify": "npm run build:verify && npm run visual:parity:smoke",
    "build:verify": "npm run build && node scripts/verify-prerender-parity.mjs && node scripts/verify-dynamic-contracts.mjs && node scripts/verify-editorial-workflow.mjs && node scripts/verify-system-content-facts.mjs",
    "gate:l1": "npm run build && node scripts/verify-prerender-parity.mjs",
    "gate:l2": "npm run visual:parity:smoke",
    "gate:l3": "npm run build && node scripts/verify-dynamic-contracts.mjs",
    "gate:all": "npm run gate:l1 && npm run gate:l3 && npm run gate:l2",
    "verify:content": "npm run verify:editorial-workflow",
    "verify:deep": "npm run gate:all",
    "verify:editorial-workflow": "node scripts/verify-editorial-workflow.mjs",
    "visual:parity": "npm run visual:parity:smoke",
    "visual:parity:smoke": "npm run build && node scripts/visual-shell-smoke.mjs",
    "visual:parity:full": "npm run build && node scripts/visual-parity.mjs --mode=full",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "build:env": "node scripts/build-friendly.mjs --print-env",
    "export:system-content-facts": "node scripts/export-system-content-facts.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.166.6",
    "@tanstack/react-router-devtools": "^1.166.6",
    "@tanstack/react-start": "^1.166.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "nitro": "3.0.1-alpha.2",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
